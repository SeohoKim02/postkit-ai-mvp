AI_PROVIDER=mock
OPENAI_API_KEY=
# 미설정 시 기본값 gpt-4o-mini 사용
OPENAI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2500
# /api/ai/* IP당 요청 한도 (미설정 시 분당 10 / 일 200)
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
AUTH_PROVIDER=
DATABASE_URL=
STORAGE_PROVIDER=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=
# true로 설정한 빌드에서만 /diagnostics 내부 진단센터가 열립니다
NEXT_PUBLIC_ENABLE_DIAGNOSTICS=
